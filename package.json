{
  "name": "cron-describe",
  "displayName": "Cron Describe",
  "description": "Hover over a cron expression to see what it means in plain English.",
  "version": "0.0.1",
  "publisher": "Afiq",
  "license": "MIT",
  "engines": {
    "vscode": "^1.90.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "configuration": {
      "title": "Cron Describe",
      "properties": {
        "cronDescribe.use24HourTime": {
          "type": "boolean",
          "default": false,
          "description": "Show times in 24-hour format (e.g. 18:00 instead of 06:00 PM)."
        }
      }
    },
    "commands": [
      {
        "command": "cronDescribe.edit",
        "title": "Edit Cron Expression",
        "category": "Cron"
      }
    ]
  },
  "scripts": {
    "compile": "tsc -p .",
    "watch": "tsc -watch -p .",
    "test": "npm run compile && node --test out/test/",
    "package": "npx --yes @vscode/vsce package",
    "bundle": "esbuild src/extension.ts --bundle --platform=node --format=cjs --target=node18 --external:vscode --minify --outfile=dist/extension.js",
    "vscode:prepublish": "npm run bundle",
    "publish": "npx --yes @vscode/vsce publish"
  },
  "devDependencies": {
    "@types/node": "^20.19.43",
    "@types/vscode": "~1.90.0",
    "cronstrue": "^2.59.0",
    "esbuild": "^0.25.12",
    "typescript": "^5.9.3"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/apikolll/cron-describe.git"
  },
  "bugs": {
    "url": "https://github.com/apikolll/cron-describe/issues"
  },
  "homepage": "https://github.com/apikolll/cron-describe#readme",
  "icon": "images/icon.png",
  "galleryBanner": {
    "color": "#1e2a3a",
    "theme": "dark"
  },
  "keywords": [
    "cron",
    "crontab",
    "schedule",
    "cron expression",
    "hover"
  ],
  "private": true
}
